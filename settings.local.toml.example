# Copied to settings.local.toml by a deployment, with its own values. Any key left out keeps the value
# settings.toml gives it; BMO_REVIEW_<TABLE>__<KEY> in the environment overrides both.

[server]
listen = "127.0.0.1:3340"
token = "review-token"

[store]
path = "/srv/bmo-review/review.db"

[[projects]]
name = "example"
checkout = "/srv/checkouts/example"

[job]
address = "http://127.0.0.1:7841"
token = "job-token"

[agency]
address = "http://127.0.0.1:3220"
token_file = "/srv/bmo/env/agency.token"

[console]
token = "console-token"
