# The review service's user unit. A deployment runs it from its deploy tree, whose settings.local.toml links
# to the data root's env/review.toml (docs/api.md, 「Settings」).
[Unit]
Description=bmo-review: code review over git checkouts
After=network-online.target
# Without its settings the service has no listen address or token, so the unit does not start where the
# deployment wrote none.
ConditionPathExists=%h/.local/share/bmo/data/env/review.toml

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-review/deploy
ExecStart=%h/.local/share/bmo-review/deploy/bin/bmo-review serve
Restart=always
RestartSec=2
# A stop waits for the service to end on its SIGTERM, which ends the event streams and lets the requests in hand
# finish; it is never escalated to a kill.
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
# The repository's one service: stopped, restarted and watched by every deployment, which waits on its health.
X-BMO-Deploy=bot
